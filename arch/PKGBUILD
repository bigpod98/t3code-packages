pkgname=t3code
pkgver=${VERSION:-0.1.10}
pkgrel=${RELEASE:-1}
pkgdesc='Desktop interface for AI coding agents'
arch=('x86_64')
url='https://t3.codes/'
license=('MIT' 'BSD-3-Clause' 'LicenseRef-T3Code-Bundled-Third-Party')
depends=('alsa-lib' 'at-spi2-core' 'gtk3' 'libcups' 'libnotify' 'libsecret'
         'libxss' 'libxtst' 'mesa' 'nss' 'util-linux-libs' 'vulkan-icd-loader' 'xdg-utils')
options=('!strip' '!debug' 'libtool' 'staticlibs' '!purge' '!zipman')

package() {
  local app="$pkgdir/usr/lib/t3code"
  local licenses="$pkgdir/usr/share/licenses/t3code"
  local assets="$startdir/packaging"

  install -d "$app" "$licenses"
  cp -a "$startdir/payload/." "$app/"
  chmod -R a+rX "$app"
  chmod 4755 "$app/chrome-sandbox"

  install -Dm755 "$assets/t3" "$pkgdir/usr/bin/t3"
  install -Dm755 "$assets/t3code" "$pkgdir/usr/bin/t3code"
  install -Dm644 "$assets/t3code.desktop" "$pkgdir/usr/share/applications/t3code.desktop"
  install -Dm644 "$assets/t3code.metainfo.xml" "$pkgdir/usr/share/metainfo/com.t3tools.t3code.metainfo.xml"
  sed -i -E "s#<release version=\"[^\"]+\" date=\"[^\"]+\"/>#<release version=\"$pkgver\" date=\"${PACKAGE_DATE:-2026-11-16}\"/>#" \
    "$pkgdir/usr/share/metainfo/com.t3tools.t3code.metainfo.xml"
  install -Dm644 "$app/t3code.png" "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/t3code.png"
  rm "$app/t3code.png"
  mv "$app/LICENSE.t3code" "$licenses/LICENSE"
  mv "$app/LICENSE.electron.txt" "$app/LICENSES.chromium.html" "$app/THIRD-PARTY-LICENSES.json" "$licenses/"
  install -m644 "$assets/THIRD-PARTY-NOTICES.md" "$licenses/"
}
