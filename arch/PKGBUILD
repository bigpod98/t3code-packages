pkgname=t3code
pkgver=0.0.32
pkgrel=1
pkgdesc='Desktop interface for AI coding agents'
arch=('x86_64')
url='https://t3.codes/'
license=('MIT')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'dbus'
  'expat'
  'gtk3'
  'libcups'
  'libdrm'
  'libgcc'
  'libnotify'
  'libsecret'
  'libstdc++'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'libxrender'
  'libxss'
  'libxtst'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'util-linux-libs'
  'xdg-utils'
)
options=('!strip' '!debug')
source=(
  't3code-payload.tar.gz'
  't3'
  't3code'
  't3code.desktop'
  't3code.metainfo.xml'
)
noextract=('t3code-payload.tar.gz')
sha256sums=(
  'PAYLOAD_SHA256'
  'T3_SHA256'
  'T3CODE_SHA256'
  'DESKTOP_SHA256'
  'METAINFO_SHA256'
)

package() {
  install -d "$pkgdir/usr/lib/t3code"
  tar --extract --gzip --file "$srcdir/t3code-payload.tar.gz" \
    --directory "$pkgdir/usr/lib/t3code"
  install -D -m 0755 "$srcdir/t3code" "$pkgdir/usr/bin/t3code"
  install -D -m 0755 "$srcdir/t3" "$pkgdir/usr/bin/t3"
  install -D -m 0644 "$srcdir/t3code.desktop" \
    "$pkgdir/usr/share/applications/t3code.desktop"
  install -D -m 0644 "$srcdir/t3code.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/com.t3tools.t3code.metainfo.xml"
  install -D -m 0644 "$pkgdir/usr/lib/t3code/t3code.png" \
    "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/t3code.png"
  install -D -m 0644 "$pkgdir/usr/lib/t3code/LICENSE.t3code" \
    "$pkgdir/usr/share/licenses/t3code/LICENSE"
  rm -f "$pkgdir/usr/lib/t3code/t3code.png"
  rm -f "$pkgdir/usr/lib/t3code/LICENSE.t3code"
  chmod 4755 "$pkgdir/usr/lib/t3code/chrome-sandbox"
}
