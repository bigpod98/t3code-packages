#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	install -d debian/t3code/usr/lib/t3code
	cp -a payload/. debian/t3code/usr/lib/t3code/
	install -D -m 0755 packaging/t3code debian/t3code/usr/bin/t3code
	install -D -m 0755 packaging/t3 debian/t3code/usr/bin/t3
	install -D -m 0644 packaging/t3code.desktop \
		debian/t3code/usr/share/applications/t3code.desktop
	install -D -m 0644 packaging/t3code.metainfo.xml \
		debian/t3code/usr/share/metainfo/com.t3tools.t3code.metainfo.xml
	install -D -m 0644 payload/t3code.png \
		debian/t3code/usr/share/icons/hicolor/1024x1024/apps/t3code.png
	install -D -m 0644 payload/LICENSE.t3code \
		debian/t3code/usr/share/doc/t3code/copyright.upstream
	install -D -m 0644 payload/LICENSE.electron.txt \
		debian/t3code/usr/share/doc/t3code/LICENSE.electron.txt
	install -D -m 0644 payload/LICENSES.chromium.html \
		debian/t3code/usr/share/doc/t3code/LICENSES.chromium.html
	install -D -m 0644 packaging/THIRD-PARTY-NOTICES.md \
		debian/t3code/usr/share/doc/t3code/THIRD-PARTY-NOTICES.md
	install -D -m 0644 payload/THIRD-PARTY-LICENSES.json \
		debian/t3code/usr/share/doc/t3code/THIRD-PARTY-LICENSES.json
	rm -f debian/t3code/usr/lib/t3code/t3code.png
	rm -f debian/t3code/usr/lib/t3code/LICENSE.t3code
	rm -f debian/t3code/usr/lib/t3code/LICENSE.electron.txt
	rm -f debian/t3code/usr/lib/t3code/LICENSES.chromium.html
	rm -f debian/t3code/usr/lib/t3code/THIRD-PARTY-LICENSES.json

override_dh_fixperms:
	dh_fixperms
	chmod 4755 debian/t3code/usr/lib/t3code/chrome-sandbox

# Preserve the tested Electron payload byte-for-byte. dh_shlibdeps still scans
# every ELF object so new Electron and native-module dependencies are detected.
override_dh_strip:

override_dh_dwz:

override_dh_compress:
	dh_compress -XLICENSE.electron.txt -XLICENSES.chromium.html \
		-XTHIRD-PARTY-NOTICES.md -XTHIRD-PARTY-LICENSES.json
