From: Primoz Ajdisek <bigpod@bigpod.si>
Subject: [PATCH] build: exclude unused node-pty Linux prebuilds

Linux rebuilds node-pty into build/Release. Do not ship unused prebuilds
for either architecture through the native package dependency scanners.

--- a/scripts/build-desktop-artifact.ts
+++ b/scripts/build-desktop-artifact.ts
@@ -1012,6 +1012,7 @@
 export const LINUX_FILE_EXCLUSIONS = [
   ...MAC_FILE_EXCLUSIONS,
   "!**/node_modules/node-pty/prebuilds/darwin-*/**/*",
+  "!**/node_modules/node-pty/prebuilds/linux-*/**/*",
 ] as const;

 // Native packages (node-pty, objc-js) ship prebuilds for both Darwin architectures; only universal
