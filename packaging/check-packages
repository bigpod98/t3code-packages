#!/bin/bash
set -euo pipefail

dist_dir=${1:-dist}
require_packages=${2:-0}
deb_count=0
rpm_count=0
arch_count=0

fail() {
  echo "Package check failed: $*" >&2
  exit 1
}

check_path() {
  manifest=$1
  path=$2
  package=$3
  if ! grep -Fqx -- "$path" <<< "$manifest"; then
    fail "$package does not contain $path"
  fi
}

check_absent_path() {
  manifest=$1
  path=$2
  package=$3
  if grep -Fqx -- "$path" <<< "$manifest"; then
    fail "$package unexpectedly contains $path"
  fi
}

for package in "$dist_dir"/*.deb; do
  test -e "$package" || continue
  deb_count=$((deb_count + 1))
  echo "Checking Debian package: $package"
  dpkg-deb --info "$package" >/dev/null || fail "$package has invalid Debian metadata"
  manifest=$(dpkg-deb --fsys-tarfile "$package" | tar -tf - | sed 's#^\./#/#') ||
    fail "$package has an unreadable filesystem archive"
  check_path "$manifest" /usr/bin/t3 "$package"
  check_path "$manifest" /usr/bin/t3code "$package"
  check_path "$manifest" /usr/lib/t3code/resources/app.asar "$package"
  check_path "$manifest" /usr/share/applications/t3code.desktop "$package"
  check_path "$manifest" /usr/share/metainfo/com.t3tools.t3code.metainfo.xml "$package"
  check_path "$manifest" /usr/share/doc/t3code/copyright.upstream "$package"
  check_path "$manifest" /usr/share/doc/t3code/LICENSE.electron.txt "$package"
  check_path "$manifest" /usr/share/doc/t3code/LICENSES.chromium.html "$package"
  check_path "$manifest" /usr/share/doc/t3code/THIRD-PARTY-LICENSES.json "$package"
  check_path "$manifest" /usr/share/doc/t3code/THIRD-PARTY-NOTICES.md "$package"
  check_absent_path "$manifest" /usr/lib/t3code/.payload-ready "$package"
  check_absent_path "$manifest" /usr/lib/t3code/THIRD-PARTY-LICENSES.json "$package"
  sandbox_metadata=$(
    dpkg-deb --fsys-tarfile "$package" |
      tar -tvf - ./usr/lib/t3code/chrome-sandbox |
      awk 'NR == 1 { print $1, $2 }'
  ) || fail "$package has unreadable chrome-sandbox metadata"
  test "$sandbox_metadata" = "-rwsr-xr-x root/root" ||
    fail "$package chrome-sandbox metadata is '$sandbox_metadata', expected '-rwsr-xr-x root/root'"
  depends=$(dpkg-deb --field "$package" Depends) ||
    fail "$package has an unreadable dependency field"
  test -n "$depends" || fail "$package has no runtime dependencies"
  case "$depends" in
    *'${'* ) fail "$package has an unexpanded Debian dependency variable" ;;
  esac
done

for package in "$dist_dir"/*.rpm; do
  test -e "$package" || continue
  rpm_count=$((rpm_count + 1))
  echo "Checking RPM package: $package"
  manifest=$(rpm -qlp "$package") || fail "$package has invalid RPM metadata"
  check_path "$manifest" /usr/bin/t3 "$package"
  check_path "$manifest" /usr/bin/t3code "$package"
  check_path "$manifest" /usr/lib/t3code/resources/app.asar "$package"
  check_path "$manifest" /usr/share/applications/t3code.desktop "$package"
  check_path "$manifest" /usr/share/metainfo/com.t3tools.t3code.metainfo.xml "$package"
  check_path "$manifest" /usr/share/licenses/t3code/LICENSE "$package"
  check_path "$manifest" /usr/share/licenses/t3code/LICENSE.electron.txt "$package"
  check_path "$manifest" /usr/share/licenses/t3code/LICENSES.chromium.html "$package"
  check_path "$manifest" /usr/share/licenses/t3code/THIRD-PARTY-LICENSES.json "$package"
  check_path "$manifest" /usr/share/licenses/t3code/THIRD-PARTY-NOTICES.md "$package"
  check_absent_path "$manifest" /usr/lib/t3code/.payload-ready "$package"
  check_absent_path "$manifest" /usr/lib/t3code/THIRD-PARTY-LICENSES.json "$package"
  sandbox_metadata=$(
    rpm -qp --queryformat \
      '[%{FILEMODES:perms} %{FILEUSERNAME}:%{FILEGROUPNAME} %{FILENAMES}\n]' \
      "$package" |
      awk '$3 == "/usr/lib/t3code/chrome-sandbox" { print $1, $2 }'
  ) || fail "$package has unreadable chrome-sandbox metadata"
  test "$sandbox_metadata" = "-rwsr-xr-x root:root" ||
    fail "$package chrome-sandbox metadata is '$sandbox_metadata', expected '-rwsr-xr-x root:root'"
  depends=$(rpm -qp --requires "$package") ||
    fail "$package has unreadable runtime dependencies"
  test -n "$depends" || fail "$package has no runtime dependencies"
done

for package in "$dist_dir"/*.pkg.tar.zst; do
  test -e "$package" || continue
  arch_count=$((arch_count + 1))
  echo "Checking Arch Linux package: $package"
  metadata=$(tar -xOf "$package" .PKGINFO)
  grep -Fxq 'pkgname = t3code' <<< "$metadata" || fail "$package has incorrect package name"
  grep -Fxq 'arch = x86_64' <<< "$metadata" || fail "$package has incorrect architecture"
  manifest=$(tar -tf "$package")
  for path in usr/bin/t3 usr/bin/t3code usr/lib/t3code/resources/app.asar \
    usr/share/applications/t3code.desktop usr/share/metainfo/com.t3tools.t3code.metainfo.xml \
    usr/share/icons/hicolor/1024x1024/apps/t3code.png \
    usr/share/licenses/t3code/{LICENSE,LICENSE.electron.txt,LICENSES.chromium.html,THIRD-PARTY-LICENSES.json,THIRD-PARTY-NOTICES.md}; do
    check_path "$manifest" "$path" "$package"
  done
  sandbox_metadata=$(tar --numeric-owner -tvf "$package" usr/lib/t3code/chrome-sandbox | awk '{print $1, $2}')
  test "$sandbox_metadata" = "-rwsr-xr-x 0/0" || fail "$package has incorrect chrome-sandbox mode or owner"
done

if test "$require_packages" = 1; then
  if test "$(uname -m)" = x86_64; then
    test "$arch_count" -eq 1 || fail "expected exactly one Arch Linux package in $dist_dir, found $arch_count"
  fi
  test "$deb_count" -eq 1 ||
    fail "expected exactly one DEB in $dist_dir, found $deb_count"
  test "$rpm_count" -eq 1 ||
    fail "expected exactly one RPM in $dist_dir, found $rpm_count"
fi
